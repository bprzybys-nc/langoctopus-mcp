# Environment variables for langoctopus-mcp

# Google API key for Gemini 2.5 Flash
GOOGLE_API_KEY=your_google_api_key_here

# API Gateway URL for Lambda implementation
# API_GATEWAY_URL=http://localhost:3000

# For SAM/Lambda local development - set to 'true' to disable auth
NOAUTH=true

# Log level
LOG_LEVEL=INFO 
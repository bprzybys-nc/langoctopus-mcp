{
  "name": "LangOctopus MCP Project",
  "description": "Defines the core structure of the LangGraph MCP agent project with retro-style UI",
  "pattern": [
    {
      "directory": "src",
      "description": "Source code for the core agent functionality",
      "children": [
        {
          "directory": "agent",
          "description": "LangGraph agent implementation",
          "children": [
            {
              "file": "client.py",
              "description": "LangGraph agent implementation (uses local MCP servers)"
            }
          ]
        },
        {
          "directory": "mcp_servers",
          "description": "Local MCP server implementations",
          "children": [
            {
              "file": "math_server.py",
              "description": "MCP server for math operations (local)"
            },
            {
              "file": "weather_server.py",
              "description": "MCP server for weather information (local)"
            }
          ]
        },
        {
          "directory": "utils",
          "description": "Utility functions and helpers"
        }
      ]
    },
    {
      "directory": "frontend",
      "description": "React-based retro-style user interface",
      "children": [
        {
          "directory": "public",
          "description": "Static assets and HTML template",
          "children": [
            {
              "file": "index.html",
              "description": "Main HTML template"
            },
            {
              "directory": "assets",
              "description": "Static assets like SVG robots",
              "children": [
                {
                  "file": "robot-left.svg",
                  "description": "Left robot SVG avatar"
                },
                {
                  "file": "robot-right.svg",
                  "description": "Right robot SVG avatar"
                }
              ]
            }
          ]
        },
        {
          "directory": "src",
          "description": "React application source code",
          "children": [
            {
              "directory": "components",
              "description": "React components",
              "children": [
                {
                  "file": "App.jsx",
                  "description": "Main application component"
                },
                {
                  "file": "ChatHistory.jsx",
                  "description": "Chat history display component"
                },
                {
                  "file": "LeftRobot.jsx",
                  "description": "Left robot component"
                },
                {
                  "file": "RightRobot.jsx",
                  "description": "Right robot component"
                }
              ]
            },
            {
              "directory": "styles",
              "description": "CSS styles",
              "children": [
                {
                  "file": "retro.css",
                  "description": "Retro-style CSS for the application"
                }
              ]
            },
            {
              "directory": "services",
              "description": "API services",
              "children": [
                {
                  "file": "api.js",
                  "description": "API service for communicating with the backend"
                }
              ]
            },
            {
              "file": "index.js",
              "description": "Application entry point"
            }
          ]
        },
        {
          "file": "package.json",
          "description": "Frontend dependencies and scripts (npm)"
        },
        {
          "file": "package-lock.json",
          "description": "npm lock file for frontend dependencies"
        }
      ]
    },
    {
      "directory": "backend",
      "description": "Flask backend server for the UI",
      "children": [
        {
          "file": "app.py",
          "description": "Flask server with Socket.IO integration"
        }
      ]
    },
    {
      "directory": "lambda",
      "description": "AWS SAM application for deploying MCP servers as Lambda functions",
      "children": [
        {
          "directory": "math",
          "description": "Lambda function for math MCP server"
        },
        {
          "directory": "weather",
          "description": "Lambda function for weather MCP server"
        },
        {
          "directory": "authorizer",
          "description": "Lambda authorizer implementation (optional)"
        },
        {
          "file": "client.py",
          "description": "Agent entrypoint using Lambda backend"
        },
        {
          "file": "client_adapter.py",
          "description": "Adapter for communicating with Lambda MCP services"
        },
        {
          "file": "README.md",
          "description": "Instructions for deploying and using the Lambda setup"
        }
      ]
    },
    {
      "directory": "scripts",
      "description": "Utility scripts",
      "children": [
        {
          "file": "run_ui.sh",
          "description": "Script to run the frontend and backend UI servers"
        }
      ]
    },
    {
      "directory": "tests",
      "description": "Test suite",
      "children": [
        {
          "file": "run_tests.py",
          "description": "Script to execute tests"
        }
      ]
    },
    {
      "directory": "config",
      "description": "Configuration files (if any)"
    },
    {
      "directory": "doc",
      "description": "Project documentation"
    },
    {
      "file": "run.py",
      "description": "Script to orchestrate starting local servers and running the main agent"
    },
    {
      "file": "test_queries.py",
      "description": "Test script with example agent queries"
    },
    {
      "file": "pyproject.toml",
      "description": "Project metadata and Python dependencies (Poetry)"
    },
    {
      "file": "poetry.lock",
      "description": "Poetry lock file for Python dependencies"
    },
    {
      "file": "README.md",
      "description": "Project documentation"
    },
    {
      "file": ".env.example",
      "description": "Example environment variables for API keys etc."
    },
    {
      "file": ".env",
      "description": "Environment variables (excluded from git)",
      "excluded": true
    },
    {
      "directory": "trash",
      "description": "Directory for obsolete/deleted files (excluded)",
      "excluded": true
    }
  ]
} 